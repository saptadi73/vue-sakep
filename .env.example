# BPRS API
# In production, use absolute backend/proxy URL that accepts POST requests.
# Example: https://api.company.com/bprs
VITE_BPRS_API_BASE_URL=/api/bprs
VITE_BPRS_USER=System
VITE_BPRS_SIGNATURE=
VITE_BPRS_DEVICE=Denmas

